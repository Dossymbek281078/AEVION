# Dependencies
node_modules/
**/node_modules/

# Next.js build artifacts
.next/
**/.next/
out/
**/out/

# Backend build artifacts
dist/
**/dist/
# Exception: catalog-client dist must be committed so CI frontend build
# can import it without a separate build step (file: workspace dep + no
# workflow scope to modify ci.yml to run tsc first).
!packages/aevion-catalog-client/dist/
build/
**/build/
# QBuild product source dirs (collide with the broad **/build/ rule above —
# these are TS/TSX modules under our own src tree, not output artifacts).
!aevion-globus-backend/src/lib/build/
!aevion-globus-backend/src/lib/build/**
!aevion-globus-backend/src/routes/build/
!aevion-globus-backend/src/routes/build/**
!frontend/src/lib/build/
!frontend/src/lib/build/**
!frontend/src/components/build/
!frontend/src/components/build/**
!frontend/src/app/build/
!frontend/src/app/build/**

# Environment variables - NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# Deprecated old portal (historical, do not commit)
aevion-portal-frontend/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.claude/

# Puzzle artifacts (generated locally)
frontend/public/puzzles-fixed.json
frontend/public/puzzles-report.json

# Temp backups
*_backup.tsx
*_backup.ts
page_v*_backup.*
# Claude Code local settings
.claude/

# Playwright MCP test artifacts (screenshots, console logs, snapshots)
# — must NOT sit in the watched project tree or Turbopack HMR-reloads mid-test
.playwright-mcp/
**/.playwright-mcp/

# Прогоны бенчмарка QReal: ссылки на рендеры, судейские листы, ключ плеч.
benchmark-out/

# Файловое хранилище MVP-модулей. В aevion-globus-backend оно уже игнорируется,
# но каталог создаётся по process.cwd(): достаточно запустить тест или скрипт
# из корня репозитория без AEVION_DATA_DIR — и он появится здесь. Внутри
# бывают секреты вебхуков, так что попасть в коммит он не должен.
.aevion-data/
# Хранилище подписок (PII). Внутрипакетный путь закрыт в
# aevion-globus-backend/.gitignore; этот шаблон закрывает файл ГДЕ УГОДНО в
# дереве — 10.08.2026 записи попали в коммиты через корневой data/, куда их клал
# прогон тестов не из каталога бэкенда (см. tests/subscriptionStorePath.test.ts).
**/data/subscriptions.jsonl
**/data/subscriptions.jsonl.tmp

# Прогоны бенчмарка QReal: ссылки на рендеры, судейские листы, ключ плеч.
benchmark-out/
# Рабочее состояние QTrade (тестовые счета и .tmp от прогонов). Внутрипакетный
# путь закрыт в aevion-globus-backend/.gitignore, корневой — не был, и 0ff550de6
# утащил в git и qtrade.json, и временный файл. Тот же случай, что с
# data/subscriptions.jsonl выше: защита не должна зависеть от того, из какой
# папки запустили.
**/.aevion-data/

.vercel
.env*

# Каталоги, которые тесты создают с номером процесса в имени:
# .aevion-data-test-12348/ и подобные. Правило `.aevion-data/` их НЕ ловит,
# и 19.08.2026 такой каталог попал под `git add -A` при сборке ветки выкатки.
.aevion-data-test-*/

.vercel
# Playwright artefacts: written by every run, useful to nobody in git.
test-results/
**/test-results/
