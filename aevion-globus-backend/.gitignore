node_modules
# Keep environment variables out of version control
.env

# Локальные JSON-стора MVP (QTrade и др.)
.aevion-data/
# Снимки того же хранилища: создаются `npm run backup` в .aevion-backups/<UTC>/.
# Содержат КОПИИ кошельков и реестра AEV, поэтому в репозиторий им нельзя тем же
# правилом, что и источнику. Команда backup вернулась 14.08.2026 — до этого
# каталог просто не появлялся, и правило было не нужно.
.aevion-backups/

# Pricing leads + analytics events + newsletter + subscriptions (PII / IP)
data/leads.jsonl
data/events.jsonl
data/newsletter.jsonl
data/subscriptions.jsonl
# Ключи дедупликации вебхуков — рантайм-состояние, как и соседи выше.
# В списке его не было: файл появляется только когда вебхук реально
# доставляли, поэтому в чистом клоне его никто не видел, а после первого
# же теста платежа он попадал в git add -A вместе с тестовыми ключами.
data/webhook-dedup.jsonl
data/affiliate.jsonl
data/partners.jsonl
# Реестр отправленных писем запуска: строки {email, at} — АДРЕСА ПОДПИСЧИКОВ.
# Имя собирается на ходу (data/launch-sent-<модуль>.jsonl), поэтому в список
# поимённых файлов оно не попало и было ЕДИНСТВЕННЫМ незащищённым файлом
# данных модуля (замер 08.09: защищено 10 из 11). Автосохранение раз в
# 30 минут добавляет широко — адреса уехали бы в историю репозитория и в
# зеркало, откуда простым способом не убираются. Звёздочка обязательна:
# модулей рассылки будет больше одного.
data/launch-sent-*.jsonl
data/edu.jsonl
data/partner-deals.jsonl

/src/generated/prisma
data/qreal-render-journal.jsonl

# build-info.json СПЕЦИАЛЬНО не игнорируется: `railway up` уважает .gitignore,
# и отметка сборки просто не уезжала в образ — /health честно отвечал "unknown".
# Файл создаётся scripts/railway-deploy.sh перед загрузкой и удаляется им же
# после; в коммит он не попадает, потому что скрипт убирает его за собой.
