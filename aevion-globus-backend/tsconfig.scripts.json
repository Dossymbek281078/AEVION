{
  // Проверка типов для каталога scripts/ — он НЕ входит в основной tsconfig.
  //
  // Зачем отдельный файл, а не расширение include в tsconfig.json: основной
  // конфиг используется сборкой (`tsc` в npm run build), и включение scripts
  // отправило бы их в dist, куда они не нужны.
  //
  // Повод конкретный (19.08.2026): я написал scripts/launch-announce-dry.ts с
  // незакрытой строкой, прогнал `tsc --noEmit`, получил ноль ошибок и доложил
  // «tsc чист». Ошибку нашёл только запуск. Основной конфиг включает лишь
  // `src/**`, поэтому все восемь .ts-скриптов были вне проверки — и я четыре раза
  // подряд отчитывался о чистоте, не покрывая их.
  //
  // Запуск: npm run check:scripts
  "extends": "./tsconfig.json",
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  // ХРАПОВИК, а не разрешение. seed-bureau.ts даёт две ошибки типов
  // («Cannot use namespace 'Pool' as a type», строки 68 и 127) — они появились
  // не сегодня, их просто никто не видел, потому что scripts/ был вне проверки.
  // Файл в чужой зоне, поэтому я его не правлю; но и оставлять команду красной
  // нельзя — красную проверку перестают запускать через неделю.
  //
  // Список может только УКОРАЧИВАТЬСЯ. Починили файл — уберите строку отсюда.
  "exclude": ["scripts/seed-bureau.ts"],
  "compilerOptions": {
    "noEmit": true,
    // rootDir основного конфига — src, и он не вмещает scripts. Здесь снимаем
    // ограничение: выхода всё равно нет (noEmit), значит корень не нужен.
    "rootDir": "."
  }
}
