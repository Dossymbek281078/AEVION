# Copy to .env and adjust.

DATABASE_URL=postgresql://postgres:password@localhost:5432/aevion_dev

AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# QCoreAI — multi-agent LLM pipeline. At least one provider key required for
# real /multi-agent runs (otherwise stub text). Recommended: ANTHROPIC + OPENAI
# so per-role overrides have headroom.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

# i18n live translation (POST /api/i18n/translate — powers site-wide language
# switching). OPTIONAL: if DEEPL_API_KEY is set, DeepL is used for its 10
# supported languages; otherwise ALL languages translate via ANTHROPIC_API_KEY
# (Claude Haiku). At least one of DEEPL_API_KEY or ANTHROPIC_API_KEY must be set
# or language switching only flips the built-in seed dictionary. Free DeepL keys
# end in ":fx". Kazakh (kk) always uses Claude (DeepL has no Kazakh).
# DEEPL_API_KEY=

# --- Free fleet ---------------------------------------------------------------
# Free / free-tier gateways that power the "Council" strategy (a crowd of free
# models drafts in parallel, then Fable 5 synthesizes). Each key you add lights
# up more free crowd members. All are OpenAI-compatible; none bill per token on
# their free tiers. Get keys at:
#   OpenRouter  https://openrouter.ai/keys        (one key → dozens of :free models)
#   Groq        https://console.groq.com/keys     (ultra-fast Llama/Qwen/Gemma)
#   Cerebras    https://cloud.cerebras.ai         (fastest inference, free tier)
#   Mistral     https://console.mistral.ai        (free tier)
#   Together    https://api.together.ai           (has a Free Llama-3.3-70B model)
#   GitHub      https://github.com/marketplace/models  (GITHUB_MODELS_TOKEN = a PAT)
#   NVIDIA NIM  https://build.nvidia.com              (nvapi-… key, no card, ~5000 free credits)
#   Ollama      set OLLAMA_BASE_URL to a local runtime (fully free, no key)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
# CEREBRAS_MODEL=llama-3.3-70b
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
GITHUB_MODELS_TOKEN=
# GITHUB_MODELS_MODEL=openai/gpt-4o-mini
NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# ── Local runtimes (offline-capable; set a *_BASE_URL to enable) ─────────────
# Each speaks the OpenAI /chat/completions dialect on localhost, so they plug
# into the same adapter. With one set, the Council can run with `offline:true`
# (crowd + chair local only). See deploy/local/ for a one-command launcher.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen2.5-7b-instruct
# JAN_BASE_URL=http://127.0.0.1:1337/v1
# JAN_MODEL=llama3.2-3b-instruct
# LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
# LOCALAI_MODEL=llama-3.2-3b-instruct
# LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1

# QCoreAI hard cap (USD). Per-run requested budget can't exceed this.
# Default 50.
QCORE_MAX_COST_USD_PER_RUN=50

# QCoreAI Council chair (Synthesizer) model. Default = claude-opus-4-8:
# a 16-Q benchmark showed it matches Fable 5's 92% win-rate over a single
# flagship at 2.8x the flagship cost (vs Fable's 3.6x) — same quality, cheaper.
# Set to claude-fable-5 for max-stakes runs. Per-request `synthModel` overrides.
# QCOREAI_SYNTH_MODEL=claude-opus-4-8

# QCoreAI Council: max chars of each free draft passed to the synthesizer
# (trims the premium input cost). Default 1600.
# QCOREAI_MAX_DRAFT_CHARS=1600

# QCoreAI webhook fan-out (env-level fallback when user has no personal hook).
# Optional. When set, run.completed events POST to this URL signed with
# QCORE_WEBHOOK_SECRET via X-QCore-Signature header.
QCORE_WEBHOOK_URL=
QCORE_WEBHOOK_SECRET=

# V6-R: optional Redis pub/sub for mid-run guidance bus. Set this on every
# backend instance + run `npm i ioredis` to enable horizontal scaling.
# Without this, behavior is the in-process Map (default, single-instance OK).
QCORE_REDIS_URL=

# -----------------------------------------------------------------------------
# Quantum Shield — HMAC secret for authenticated Shamir shards.
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be 32 bytes (base64-encoded). Rotation: add SHARD_HMAC_SECRET_V2 and bump
# HMAC_KEY_VERSION in src/config/qright.ts (not in scope for v2 Tier 1).
# -----------------------------------------------------------------------------
SHARD_HMAC_SECRET=

# -----------------------------------------------------------------------------
# VeilNetX — privacy ledger HMAC blinding + edge-hop detection.
# -----------------------------------------------------------------------------
# HMAC salt used to blind from/to identifiers before they hit the append-only
# ledger. REQUIRED in production (backend throws on boot if unset); dev falls
# back to SHARD_HMAC_SECRET, then a hard-coded dev salt. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VEILNETX_SALT=

# Number of trailing X-Forwarded-For hops that are our own edge infra (Railway/CF)
# and must be stripped before judging proxy exposure. Defaults to 1 on Railway, 0 elsewhere.
VEILNETX_TRUSTED_EDGE_HOPS=

# -----------------------------------------------------------------------------
# QSign v1 / pipeline HMAC secret (legacy; used by pipeline.ts and
# planetCompliance.ts, also by GET /api/pipeline/verify/:id). REQUIRED (>=16 chars).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this value invalidates HMAC re-verification for all existing
# IPCertificate rows — do not rotate casually.
# -----------------------------------------------------------------------------
QSIGN_SECRET=

# -----------------------------------------------------------------------------
# QSign v2 (new /api/qsign/v2/* endpoints)
# Kid-scoped keys. Referenced from the QSignKey table by env var name.
# In production these MUST be set; dev falls back to ephemeral material.
# -----------------------------------------------------------------------------
# HMAC-SHA256 active key (min 16 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QSIGN_HMAC_V1_SECRET=

# Ed25519 active key - 64-char hex = raw 32-byte seed. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QSIGN_ED25519_V1_PRIVATE=
# Optional - if set, must be 64-char hex and match the public key derived from V1_PRIVATE.
# If omitted, backend derives and caches on first boot.
QSIGN_ED25519_V1_PUBLIC=

# -----------------------------------------------------------------------------
# AEV wallet/ledger storage
# -----------------------------------------------------------------------------
# Where jsonFileStore writes wallet/ledger snapshots (relative to cwd if
# omitted → ./.aevion-data). Override для Docker/прода персистентного volume.
AEVION_DATA_DIR=

# -----------------------------------------------------------------------------
# Demo / dev-only
# -----------------------------------------------------------------------------
# Enable stateless demo endpoints for the /reconstruct-demo UI.
# DO NOT enable in production unless you want the endpoints publicly reachable.
# Default: false. In-memory rate-limit 10 req/min/IP applies when enabled.
ENABLE_DEMO_ENDPOINTS=false

# -----------------------------------------------------------------------------
# QBuild — payment webhook & AI surfaces
# -----------------------------------------------------------------------------
# Webhook HMAC secret for POST /api/build/webhooks/payment.
# If unset, the webhook only accepts requests from localhost (dev mode).
# In production MUST be set; Stripe/YooKassa sign payloads with this secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUILD_PAYMENT_WEBHOOK_SECRET=

# Anthropic key for QBuild AI surfaces:
#   POST /api/build/ai/consult       — career coach chat
#   POST /api/build/ai/parse-resume  — resume parser (text + image)
#   POST /api/build/ai/improve-text  — rewrite snippets
# Without this key all three endpoints return a 500 with "ANTHROPIC_API_KEY not configured".
# Rate-limited to 10 calls per 10 minutes per user.
ANTHROPIC_API_KEY=

# Resend API key for email notifications (job alerts, application accept/reject, verification):
#   https://resend.com — free tier: 3000 emails/month
#   If unset, email notifications are silently skipped (platform still works)
RESEND_API_KEY=

# Optional: URL of your employer's webhook endpoint for new application events
#   POST with JSON { event: "application.new", applicationId, vacancyId, ... }
#   Signed with BUILD_PAYMENT_WEBHOOK_SECRET (X-Aevion-Signature header)
BUILD_APPLICATION_WEBHOOK_URL=

# Web Push (VAPID) — enables browser push notifications for new applications,
# messages, shift reminders, etc. Without these keys push.subscribe 201s into
# the DB but sendToUser() returns { configured: false } silently.
#
# How to generate your own keys (one-time, keep private key secret):
#   node -e "const c=require('crypto'),e=c.createECDH('prime256v1');e.generateKeys();console.log({pub:e.getPublicKey('base64url'),priv:e.getPrivateKey('base64url')})"
#
# Or use the pre-generated pair below (rotate in production if this file leaks):
VAPID_PUBLIC_KEY=BPHAuDeHSOoXvyIeTtx8T8g7xjqUqsg_DaP0POBURlT80RsZ7X-RcuS0XzSgvZGdXeLtMowK2k_4Dk_AQshTFQ8
VAPID_PRIVATE_KEY=MV4qjOQQxX72ZSetbuwGUeGQBAUeF5J1jXg7PFfue6o
VAPID_SUBJECT=mailto:noreply@aevion.app

# Daily.co video rooms — live video call between recruiter and candidate.
# Without this key createDailyRoom() returns a stub URL (works for dev, wrong in prod).
# Free account at https://www.daily.co/ → API → create key.
# Copy the "API key" string (starts with "live_" or similar).
DAILY_API_KEY=

# Canonical site URL for sitemap.ts (Next.js). Set in Vercel env.
NEXT_PUBLIC_SITE_URL=https://aevion.app

# -----------------------------------------------------------------------------
# Stripe — payment provider for Bureau certs + QPayNet deposits + QSign v2 keys.
# Live-mode required only when accepting real payments. Defaults to stub.
#
# To activate (go-live checklist):
#   1. Get keys at https://dashboard.stripe.com/apikeys
#   2. Configure webhook at https://dashboard.stripe.com/webhooks
#      Endpoint URL:  https://api.aevion.app/api/qpaynet/webhook/stripe
#      Events:        checkout.session.completed, payment_intent.succeeded,
#                     payment_intent.payment_failed, charge.refunded
#   3. Copy webhook signing secret → STRIPE_WEBHOOK_SECRET
#   4. Set BUREAU_PAYMENT_PROVIDER=stripe on Railway
#   5. Restart backend
# -----------------------------------------------------------------------------
BUREAU_PAYMENT_PROVIDER=stub                   # "stub" (dev) or "stripe" (live)
STRIPE_SECRET_KEY=                             # sk_test_… or sk_live_…
STRIPE_WEBHOOK_SECRET=                         # whsec_… (from dashboard)
STRIPE_PUBLISHABLE_KEY=                        # pk_test_… or pk_live_… (frontend)
AEVION_PUBLIC_BASE_URL=https://aevion.app      # used for Stripe success/cancel redirects
