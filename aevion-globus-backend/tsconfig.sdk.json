{
  // Проверка типов для sdk/ — восемь клиентских библиотек, которые НЕ входили
  // ни в один конфиг репозитория. Замер 04.09.2026: из 3039 файлов .ts/.tsx
  // вне проверки типов оказалось 32, и восемь из них — здесь.
  //
  // Почему это важнее прочего непокрытого: sdk отдают интеграторам, у каждого
  // клиента свой package.json с полем "types". То есть мы публикуем обещание
  // типов, не проверяя его.
  //
  // Запуск: npm run check:sdk. Ошибок на момент заведения: 0 — то есть
  // находка в отсутствии проверки, а не в качестве кода.
  //
  // ВАЖНО про include: src нужен не для проверки src, а потому что там лежит
  // src/types/ambient.d.ts. Без него узкий охват дал 19 ФАНТОМНЫХ ошибок
  // («не найдено имя process», «Buffer»), и они выглядели как настоящие
  // дефекты SDK. Соседний tsconfig.scripts.json включает src по той же
  // причине. Лечить это полем "types": ["node"] тоже можно, но поле не
  // дополняет список, а заменяет — так недолго выключить то, что нужно.
  "extends": "./tsconfig.json",
  "include": ["sdk/**/*.ts", "src/**/*.ts", "src/**/*.d.ts"],
  "compilerOptions": {
    "noEmit": true,
    // rootDir основного конфига — src, и он не вмещает sdk. Выхода нет
    // (noEmit), значит ограничение безвредно.
    "rootDir": "."
  }
}
