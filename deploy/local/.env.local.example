# ─────────────────────────────────────────────────────────────────────────────
# AEVION QCoreAI — OFFLINE preset
#
# Copy the two blocks below into the matching env files, start a local runtime
# (Ollama by default), and the Council runs with the internet fully OFF.
# No cloud keys are required for offline mode.
#
#   backend  → aevion-globus-backend/.env
#   frontend → frontend/.env.local
#
# The one-command launcher deploy/local/run-local.ps1 writes both for you.
# ─────────────────────────────────────────────────────────────────────────────

# ═══ BACKEND (aevion-globus-backend/.env) ════════════════════════════════════

# --- Local runtime: pick ONE (or several) and set its base URL. ---
# Ollama (default, easiest): https://ollama.com — `ollama serve` then `ollama pull`.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# LM Studio (GUI): enable the local server (port 1234), load a model.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=qwen2.5-7b-instruct

# Jan (fully-offline desktop app): enable the local API server (port 1337).
# JAN_BASE_URL=http://127.0.0.1:1337/v1
# JAN_MODEL=llama3.2-3b-instruct

# LocalAI (drop-in OpenAI replacement, port 8080):
# LOCALAI_BASE_URL=http://127.0.0.1:8080/v1
# LOCALAI_MODEL=llama-3.2-3b-instruct

# llama.cpp server (bare engine; set a distinct port if 8080 is taken by LocalAI):
# LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1

# Optional: force the offline council's chair (Synthesizer). Defaults to the
# first configured local runtime's default model. Point it at your biggest local
# model for the best fusion quality.
# QCOREAI_SYNTH_MODEL=qwen2.5:7b

# Local server port (frontend proxy must match, below). Default 4001.
PORT=4001

# NOTE: leave ANTHROPIC_API_KEY / OPENAI_API_KEY / OPENROUTER_API_KEY UNSET for a
# pure-offline run. If you set them, they simply become available as *online*
# options — the offline toggle still restricts a run to local runtimes only.

# ═══ FRONTEND (frontend/.env.local) ══════════════════════════════════════════

# Point the Next.js proxy at your LOCAL backend instead of Railway.
BACKEND_PROXY_TARGET=http://127.0.0.1:4001
