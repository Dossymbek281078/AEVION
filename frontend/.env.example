# ───────────────────────────────────────────────────────────────────
# AEVION frontend-exchange · environment variables example
# Copy to .env.local (gitignored) before `npm run dev` / `npm run build`.
# ───────────────────────────────────────────────────────────────────

# ── Canonical site URL (sitemap, robots, OG, JSON-LD) ────────────
# Production: https://aevion.app
# Code default fallback also points to aevion.app, so this is optional but
# recommended (avoids drift if domain changes again).
NEXT_PUBLIC_SITE_URL=https://aevion.app

# ── Backend proxy ────────────────────────────────────────────────
# Browser hits same-origin /api-backend/* and Next rewrites to this URL.
# Production: https://aevion-production-a70c.up.railway.app
# (or https://api.aevion.app if you've wired the CNAME.)
BACKEND_PROXY_TARGET=http://127.0.0.1:4001

# ── AEV wallet/ledger backend (opt-in) ───────────────────────────
# Когда задан → frontend syncит wallet/ledger в backend (см. src/lib/aevApi.ts).
# Без env-var → wallet остаётся pure-localStorage (current behaviour).
NEXT_PUBLIC_AEV_BACKEND_URL=

# ── Адрес бэкенда для браузерных запросов ────────────────────────
# Читается ПЕРВОЙ в getBackendOrigin()/getApiBase() (src/lib/apiBase.ts).
# Если не задана — берётся API_INTERNAL_BASE_URL, затем http://127.0.0.1:4001.
# На проде обычно не нужна (браузер идёт через same-origin /api-backend/*),
# но задать её — единственный способ увести фронт на другой бэкенд без сборки.
NEXT_PUBLIC_API_BASE_URL=

# ── Режим банка ──────────────────────────────────────────────────
# ⚠️ Значение по умолчанию — "test". Это значит: если переменную НЕ задать,
# на проде поверх банка висит баннер «тестовый режим». Скрывается только
# значениями production / prod / live (см. bank/_components/TestModeBanner.tsx).
NEXT_PUBLIC_BANK_MODE=test

# ── Версия релиза для Sentry ─────────────────────────────────────
# Передаётся в Sentry.init как `release` (src/lib/sentry.ts). Без неё события
# не группируются по версиям — то есть регресс не отличить от старой ошибки.
NEXT_PUBLIC_SENTRY_RELEASE=

# ── Coach backend для healthai и cyberchess (opt-in) ─────────────
# Используется в 6 страницах healthai и в cyberchess/WhatIfButton.tsx.
# Если НЕ задан, код падает на зашитый адрес Railway
# (https://aevion-production-a70c.up.railway.app) — то есть на новой машине
# healthai молча пойдёт в прод. Отсюда две вещи:
#   • для локальной разработки задавай http://localhost:4001;
#   • это ВТОРОЙ способ определять адрес бэкенда рядом с getBackendOrigin()
#     из src/lib/apiBase.ts. Свести к одному источнику правды стоит, но
#     сначала надо посмотреть, что реально задано на Vercel — иначе замена
#     сломает healthai.
NEXT_PUBLIC_COACH_BACKEND=

# ── Telemetry sinks (optional forward seams) ─────────────────────
# When set, /api/metrics POST is forwarded to this URL (Web Vitals).
METRICS_FORWARD_URL=
# When set, /api/errors POST is forwarded to this URL (client errors).
ERRORS_FORWARD_URL=

# ── Sentry (skip-if-no-DSN guards in sentry.{client,server,edge}.config.ts) ──
# Both empty → SDK НЕ инициализируется, /api/errors остаётся единственным sink.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=
SENTRY_ENV=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_TRACES_SAMPLE_RATE=0.05
# Source-map upload (опц.) — для Sentry CLI; используется withSentryConfig.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Versioning (отображается в /api/health → version) ────────────
# CI/CD set this to commit SHA or release tag; default is "dev".
NEXT_PUBLIC_APP_VERSION=dev

# ── Bundle analyzer (npm run analyze) ────────────────────────────
ANALYZE=

# ── AEV wallet/ledger backend (opt-in) ───────────────────────────
# Когда задан → frontend syncит wallet/ledger в backend (см. src/lib/aevApi.ts).
# Без env-var → wallet остаётся pure-localStorage (default behaviour).
# Backend endpoints: aevion-globus-backend src/routes/aev.ts
NEXT_PUBLIC_AEV_BACKEND_URL=
