{
  // Проверка типов ДЛЯ ТЕСТОВ. Отдельным конфигом, а не правкой tsconfig.json.
  //
  // ПОЧЕМУ НЕ В ОСНОВНОМ. `next build` берёт tsconfig.json и падает на любой
  // ошибке типов (ignoreBuildErrors не задан — проверено). Включи тесты туда —
  // и опечатка в чужом тесте уронит БОЕВУЮ СБОРКУ и заблокирует выкатку.
  // Вкладок, правящих тесты, около десяти; цена такой связи выше пользы.
  //
  // ЧТО ЭТО ДАЁТ. 242 файла тестов фронта до 04.09.2026 не проверялись типами
  // вовсе: единственной проверкой была сборка, а она их исключает. Запуск —
  // `npm run typecheck:tests`. Замер в день заведения: 0 ошибок и на этой
  // ветке, и на дереве, слитом с продом.
  //
  // Наследует include и compilerOptions основного конфига; отличие одно —
  // не исключает *.test.ts, *.test.tsx и src/components/__tests__.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules"]
}
